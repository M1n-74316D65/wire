# OpenAI-compatible API (OpenAI, OpenRouter, Groq, local, etc.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Required to generate article summaries
SUMMARIZE_PASSWORD=

# Decision model (System One — topic routing). Optional; without it, topics stay source-based.
# Swap endpoint/model for OpenCode, TypeSafe, MixRoute, or a local System One server.
DECISION_API_KEY=
DECISION_BASE_URL=https://opencode.ai/inference/systemone/v1/systemone
DECISION_MODEL=jev-1.13-free
DECISION_MIN_CONFIDENCE=0.45

# Protects /api/ingest in production (Authorization: Bearer …)
CRON_SECRET=
