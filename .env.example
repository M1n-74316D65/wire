# OpenAI-compatible API (OpenAI, OpenRouter, Groq, local, etc.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Required to generate article summaries
SUMMARIZE_PASSWORD=

# Decision model (System One — topic routing). Optional; without it, topics stay source-based.
# Default: OpenRouter Mercury Decide free. Same key shape as AI_* (e.g. sk-or-…).
DECISION_API_KEY=
DECISION_BASE_URL=https://openrouter.ai/api/alpha/decisions
DECISION_MODEL=inception/mercury-decide:free
DECISION_MIN_CONFIDENCE=0.45
# Model calls per ingest (only multi-topic sources). Keep low to conserve quota.
DECISION_CLASSIFY_LIMIT=20
DECISION_CLASSIFY_CONCURRENCY=2

# Protects /api/ingest in production (Authorization: Bearer …)
CRON_SECRET=
