# OpenAI-compatible API (OpenAI, OpenRouter, Groq, local, etc.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Required to generate article summaries
SUMMARIZE_PASSWORD=

# Protects /api/ingest in production (Authorization: Bearer …)
CRON_SECRET=

# Optional: override the SQLite file location (default ./data/news.sqlite).
# Tests use this to simulate a database that cannot be opened.
WIRE_DB_PATH=
